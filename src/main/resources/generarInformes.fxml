<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controlador.GenerarInformesControlador"
      spacing="15"
      style="-fx-padding: 30; -fx-background-color: #f0f0f0;"
      prefWidth="700" prefHeight="550">

    <Label text="Generar Informes de Seguimiento"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="labelInfo" style="-fx-font-size: 13px;"/>

    <Label text="Horas registradas:"
           style="-fx-font-weight: bold;"/>

    <TableView fx:id="tablaSeguimientos" prefHeight="180">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120">
                <cellValueFactory><PropertyValueFactory property="fecha"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colHoras" text="Horas" prefWidth="80">
                <cellValueFactory><PropertyValueFactory property="horas"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="280">
                <cellValueFactory><PropertyValueFactory property="descripcion"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colValidado" text="Validado" prefWidth="80">
                <cellValueFactory><PropertyValueFactory property="validado"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Label text="Evaluaciones:"
           style="-fx-font-weight: bold;"/>

    <TableView fx:id="tablaEvaluaciones" prefHeight="120">
        <columns>
            <TableColumn fx:id="colNota" text="Nota" prefWidth="80">
                <cellValueFactory><PropertyValueFactory property="nota"/></cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colComentarios" text="Comentarios" prefWidth="400">
                <cellValueFactory><PropertyValueFactory property="comentarios"/></cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <Label fx:id="labelResumen" style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

    <Label fx:id="mensajeInfo" style="-fx-font-size: 12px;"/>

    <HBox spacing="10">
        <Button text="Generar informe en consola"
                onAction="#handleGenerar"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
        <Button text="Volver"
                onAction="#handleVolver"
                style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
    </HBox>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controlador.PanelAdminControlador"
      spacing="20"
      style="-fx-padding: 40; -fx-alignment: center; -fx-background-color: #f0f0f0;"
      prefWidth="600" prefHeight="400">

    <Label text="Panel de Administrador"
           style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label fx:id="labelBienvenida"
           style="-fx-font-size: 14px;"/>

   <Button text="Gestionar Usuarios"
        onAction="#handleGestionarUsuarios"
        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 20 8 20;"
        maxWidth="Infinity"/>

    <Button text="Gestionar Empresas"
        onAction="#handleGestionarEmpresas"
        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 20 8 20;"
        maxWidth="Infinity"/>

    <Button text="Asignar Prácticas"
        onAction="#handleAsignarPracticas"
        style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-size: 13px; -fx-padding: 8 20 8 20;"
        maxWidth="Infinity"/>

    <Button text="Cerrar sesión"
            onAction="#handleCerrarSesion"
            style="-fx-background-color: #f44336; -fx-text-fill: white; 
                   -fx-font-size: 13px; -fx-padding: 8 20 8 20;"
            maxWidth="Infinity"/>

</VBox>
<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controlador.RegistrarHorasControlador"
      spacing="15"
      style="-fx-padding: 30; -fx-background-color: #f0f0f0;"
      prefWidth="700" prefHeight="500">

    <Label text="Registrar Horas"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label fx:id="labelPractica"
           style="-fx-font-size: 13px;"/>

    <!-- TABLA -->
    <TableView fx:id="tablaSeguimientos" prefHeight="220">
        <columns>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="120">
                <cellValueFactory>
                    <PropertyValueFactory property="fecha"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colHoras" text="Horas" prefWidth="80">
                <cellValueFactory>
                    <PropertyValueFactory property="horas"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colDescripcion" text="Descripción" prefWidth="280">
                <cellValueFactory>
                    <PropertyValueFactory property="descripcion"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colValidado" text="Validado" prefWidth="80">
                <cellValueFactory>
                    <PropertyValueFactory property="validado"/>
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <!-- FORMULARIO -->
    <HBox spacing="10">
        <DatePicker fx:id="campoFecha" promptText="Fecha"/>
        <TextField fx:id="campoHoras" promptText="Horas" prefWidth="80"/>
        <TextField fx:id="campoDescripcion" promptText="Descripción" prefWidth="280"/>
    </HBox>

    <Label fx:id="mensajeInfo"
           style="-fx-font-size: 12px;"/>

    <!-- BOTONES -->
    <HBox spacing="10">
        <Button text="Registrar"
                onAction="#handleRegistrar"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
        <Button text="Volver"
                onAction="#handleVolver"
                style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
    </HBox>

</VBox>
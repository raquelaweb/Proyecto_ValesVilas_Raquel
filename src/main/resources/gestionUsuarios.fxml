<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controlador.GestionUsuariosControlador"
      spacing="15"
      style="-fx-padding: 30; -fx-background-color: #f0f0f0;"
      prefWidth="700" prefHeight="500">

    <Label text="Gestión de Usuarios"
           style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <!-- TABLA -->
    <TableView fx:id="tablaUsuarios" prefHeight="250">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50">
                <cellValueFactory>
                    <PropertyValueFactory property="id"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="150">
                <cellValueFactory>
                    <PropertyValueFactory property="nombre"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="200">
                <cellValueFactory>
                    <PropertyValueFactory property="email"/>
                </cellValueFactory>
            </TableColumn>
            <TableColumn fx:id="colRol" text="Rol" prefWidth="120">
                <cellValueFactory>
                    <PropertyValueFactory property="rol"/>
                </cellValueFactory>
            </TableColumn>
        </columns>
    </TableView>

    <!-- FORMULARIO -->
    <HBox spacing="10">
        <TextField fx:id="campoNombre" promptText="Nombre" prefWidth="150"/>
        <TextField fx:id="campoEmail" promptText="Email" prefWidth="180"/>
        <TextField fx:id="campoPassword" promptText="Contraseña" prefWidth="120"/>
        <ComboBox fx:id="comboRol" prefWidth="130"/>
    </HBox>

    <Label fx:id="mensajeInfo"
           style="-fx-text-fill: green; -fx-font-size: 12px;"/>

    <!-- BOTONES -->
    <HBox spacing="10">
        <Button text="Añadir"
                onAction="#handleAnadir"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
        <Button text="Actualizar"
                onAction="#handleActualizar"
                style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
        <Button text="Eliminar"
                onAction="#handleEliminar"
                style="-fx-background-color: #f44336; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
        <Button text="Volver"
                onAction="#handleVolver"
                style="-fx-background-color: #9E9E9E; -fx-text-fill: white; -fx-padding: 8 20 8 20;"/>
    </HBox>

</VBox>